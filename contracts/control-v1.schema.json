{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arl:contract:control-v1",
  "title": "arl control message v1",
  "description": "Mensaje de control del protocolo arl v1. Un frame de control = u32 BE length (1..16384) + este objeto JSON UTF-8. Semantica en docs/protocol.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "payload"],
  "properties": {
    "schema_version": {
      "const": "arl.control/v1"
    },
    "type": {
      "enum": [
        "hello",
        "capabilities",
        "config.get",
        "config.set",
        "ack",
        "error",
        "event",
        "ping",
        "pong"
      ]
    },
    "request_id": {
      "$ref": "#/$defs/request_id"
    },
    "expected_revision": {
      "$ref": "#/$defs/revision"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "payload": {
      "type": "object",
      "maxProperties": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "hello",
              "capabilities",
              "config.get",
              "config.set",
              "ack",
              "error",
              "ping",
              "pong"
            ]
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["request_id"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/hello_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "capabilities"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["revision"],
        "properties": {
          "payload": {
            "$ref": "#/$defs/capabilities_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "config.get"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/config_get_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "config.set"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["expected_revision"],
        "properties": {
          "payload": {
            "$ref": "#/$defs/config_set_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ack"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["revision"],
        "properties": {
          "payload": {
            "$ref": "#/$defs/ack_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/error_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "event"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["revision"],
        "properties": {
          "payload": {
            "$ref": "#/$defs/event_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": ["ping", "pong"]
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Identificador de operacion, unico por cliente y sesion."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Revision de configuracion del daemon (2^53-1 maximo para exactitud JSON)."
    },
    "config_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,3}$",
      "description": "Clave de configuracion; la existencia y el alcance los valida el daemon."
    },
    "config_value": {
      "type": ["boolean", "number"],
      "minimum": -1000000,
      "maximum": 1000000
    },
    "config_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "$ref": "#/$defs/config_key"
        },
        "value": {
          "$ref": "#/$defs/config_value"
        }
      }
    },
    "config_snapshot": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/config_key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/config_value"
      }
    },
    "hello_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "version", "protocol_version"],
      "properties": {
        "role": {
          "enum": ["android", "linux-cli", "linux-daemon"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z.+-]{1,64}$"
        },
        "protocol_version": {
          "const": "arl.control/v1"
        }
      }
    },
    "config_get_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "oneOf": [
            {
              "$ref": "#/$defs/config_key"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "config_set_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "$ref": "#/$defs/config_key"
        },
        "value": {
          "$ref": "#/$defs/config_value"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "key": {
                "const": "audio.sample_rate_hz"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": 48000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "audio.frame_duration_ms"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "audio.gain_db"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": -24,
                "maximum": 24,
                "multipleOf": 0.5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "audio.mute"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "audio.jitter_target_ms"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 5,
                "maximum": 40
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "ui.theme"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "enum": ["system", "light", "dark"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "ui.text_scale"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 1.0,
                "maximum": 2.0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "device.local_volume"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "device.model"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        }
      ]
    },
    "ack_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "requested", "effective"],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "requested": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/config_pair"
            }
          ]
        },
        "effective": {
          "anyOf": [
            {
              "$ref": "#/$defs/config_pair"
            },
            {
              "$ref": "#/$defs/config_snapshot"
            }
          ],
          "description": "Par {key,value} para config.set; mapa clave->valor para el snapshot de config.get."
        }
      }
    },
    "error_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "invalid",
            "version_unsupported",
            "request_id_reuse",
            "conflict",
            "local_key",
            "denied",
            "unsupported",
            "busy",
            "unauthorized",
            "too_large",
            "not_found",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "retryable": {
          "type": "boolean"
        },
        "current_revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "event_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "data"],
      "properties": {
        "name": {
          "enum": ["config.changed", "session.state"]
        },
        "data": {
          "type": "object",
          "maxProperties": 64
        }
      }
    },
    "capabilities_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "device_id",
        "role",
        "features",
        "remote_actions",
        "limits",
        "config_keys"
      ],
      "properties": {
        "schema_version": {
          "const": "arl.capabilities/v1"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "role": {
          "enum": ["android", "linux-cli", "linux-daemon"]
        },
        "features": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["control.v1", "audio.pcm16-48k-mono", "enrollment.v1", "session.v1"]
          }
        },
        "remote_actions": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["config.read", "config.write"]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_control_payload_bytes",
            "max_audio_datagram_bytes",
            "max_reorder_ms",
            "max_config_keys",
            "max_request_id_len"
          ],
          "properties": {
            "max_control_payload_bytes": {
              "const": 16384
            },
            "max_audio_datagram_bytes": {
              "const": 1200
            },
            "max_reorder_ms": {
              "const": 20
            },
            "max_config_keys": {
              "const": 32
            },
            "max_request_id_len": {
              "const": 64
            }
          }
        },
        "config_keys": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/config_key_declaration"
          }
        }
      }
    },
    "config_key_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "type"],
      "properties": {
        "key": {
          "$ref": "#/$defs/config_key"
        },
        "scope": {
          "enum": ["shared", "local", "readonly"]
        },
        "type": {
          "enum": ["boolean", "integer", "number", "string"]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    }
  }
}

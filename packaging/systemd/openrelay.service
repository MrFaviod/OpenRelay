[Unit]
Description=openrelay — daemon local (socket de control y sesiones QUIC)

[Service]
Type=exec
ExecStart=%h/.local/bin/openrelay daemon
Restart=on-failure
RestartSec=2s

# El daemon escribe el socket en %t y su identidad en ~/.config/openrelay;
# el resto del sistema queda de sólo lectura. ExecStartPre crea el directorio
# de estado antes de que ProtectSystem=strict lo intente escribir.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=%t %h/.config
ExecStartPre=install -d -m 0700 %h/.config/openrelay
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target

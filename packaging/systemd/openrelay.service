[Unit]
Description=openrelay — daemon local (socket de control y sesiones QUIC)

[Service]
Type=exec
ExecStart=%h/.local/bin/openrelay daemon
Restart=on-failure
RestartSec=2s

# El daemon sólo escribe en su directorio de ejecución (%t = XDG_RUNTIME_DIR);
# el resto del sistema queda de sólo lectura.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=%t
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target

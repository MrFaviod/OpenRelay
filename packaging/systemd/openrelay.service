[Unit]
Description=openrelay — local daemon (control socket and QUIC sessions)

[Service]
Type=exec
ExecStart=%h/.local/bin/openrelay daemon
Restart=on-failure
RestartSec=2s

# The daemon writes its socket to %t and its identity to ~/.config/openrelay;
# the rest of the system stays read-only. ExecStartPre creates the state
# directory before ProtectSystem=strict tries to write it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=%t %h/.config
ExecStartPre=install -d -m 0700 %h/.config/openrelay
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target

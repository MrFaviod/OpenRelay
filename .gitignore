# Rust build output (Cargo.lock is tracked)
/target/
**/target/
*.rs.bk

# cargo-fuzz local corpus and crash artifacts (/fuzz/target/ is covered by **/target/)
/fuzz/corpus/
/fuzz/artifacts/

# Android build output and local SDK/IDE state
/android/.gradle/
/android/.idea/
/android/local.properties
/android/**/build/
/android/app/src/main/cpp/.cxx/
/android/app/.cxx/
*.apk
*.aab

# Local artifacts and scratch files
*.log
*.tmp
.scratch/
/tmp/
/artifacts/

# Local release output; releases are built in CI
/dist/

# Python caches (verification tooling only; the product has no Python)
__pycache__/
*.py[cod]
.pytest_cache/

# Isolated virtualenv for the test-only jsonschema dependency
/.venv/
/tools/.venv/

# Editors and OS files
.DS_Store
.idea/
.vscode/
*.swp
*~

# Secrets and identity material (never commit)
*.pem
*.key
*.p12
*.jks
*.keystore

# Local daemon state and per-machine configuration
/.openrelay/
/config.toml
/.cargo/config.toml
